{
  "name": "dsh-phl",
  "private": true,
  "license": "MIT",
  "version": "0.1.0-alpha.4",
  "type": "module",
  "description": "PHL — an independent, PCL-inspired instance & runtime manager for DeepSeek Harness",
  "scripts": {
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "tauri": "tauri",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:alpha": "node scripts/alpha-gate.mjs",
    "test:e2e:core": "node scripts/e2e-gate.mjs core",
    "test:e2e:smoke": "node scripts/e2e-gate.mjs smoke",
    "test:desktop": "node scripts/alpha-desktop.mjs",
    "bridge:check": "node scripts/check-tauri-bridge.mjs",
    "icon": "node scripts/make-icon.mjs",
    "icon:all": "node scripts/make-icon.mjs --all --out=src-tauri/icons/candidates/ds-tail/build",
    "check:size": "node scripts/check-file-size.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "motion": "^12.23.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
