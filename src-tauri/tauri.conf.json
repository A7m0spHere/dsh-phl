{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PHL",
  "version": "0.1.0-alpha.1",
  "identifier": "dev.dshphl.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PHL",
        "width": 1000,
        "height": 660,
        "minWidth": 780,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "focus": true,
        "shadow": true,
        "dragDropEnabled": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https://github.com https://avatars.githubusercontent.com https://raw.githubusercontent.com https://img.shields.io; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://raw.githubusercontent.com"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "dsh-phl",
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "DSH Instance & Runtime Manager",
    "longDescription": "PHL 让多个 DSH 版本在同一台机器上共存，每个实例固定自己的 DSH、Runtime 与插件，可同时运行且互不污染。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
